function entryDetail(x){const r=[['Duration',x.dur],['Frequency',x.freq],['Affected',(x.imp||[]).join(', ')],['Cycle context',x.cyc],[x.ctx&&x.ctx.q?x.ctx.q:'',x.ctx&&x.ctx.a],['Notes',x.notes]].filter(a=>a[0]&&a[1]);return r.length?r.map(([k,v])=>`<div><b>${e(k)}:</b> ${e(v)}</div>`).join(''):'<span class="mu">No extra details recorded.</span>'}
function entryCard(x,act){const o=V.tl.open[x.id];return`<div class="tli ${V.tl.hl===x.id?'hl':''}"><span class="dot" style="background:var(--s${x.sev})"></span><div class="card" style="padding:.8rem 1rem"><div class="row sp" style="flex-wrap:nowrap"><button data-a="tlopen" data-id="${x.id}" aria-expanded="${!!o}" style="background:none;border:0;text-align:left;cursor:pointer;color:var(--ink);font:inherit;flex:1;padding:0"><h4 style="display:inline">${e(x.name||x.cat)}</h4> ${sevChip(x.sev)}<br><span class="sm mu">${fmt(x.date)}${x.time?' · '+e(x.time):''} · ${e(x.cat)}</span></button>${act?`<div class="row" style="flex-wrap:nowrap"><button class="btn sm" data-a="editent" data-id="${x.id}" aria-label="Edit entry ${e(x.name||x.cat)}">${ico('edit',16)}</button><button class="btn sm d" data-a="delent" data-id="${x.id}" aria-label="Delete entry ${e(x.name||x.cat)}">${ico('trash',16)}</button></div>`:''}</div>${o?`<div class="sm" style="margin-top:.6rem;border-top:1px solid var(--line);padding-top:.6rem">${entryDetail(x)}</div>`:''}</div></div>`}

/* Overview */
function overview(){const es=sorted(),r=inRange(30),g=S.set.lang==='hi'?tr('welcome'):'Welcome to your health space';
const body=!es.length?emptyState('Your timeline starts here','Add your first entry, such as how you felt today. It takes under a minute, and everything stays in this browser.',addFirst):`<div class="g4" style="margin-bottom:1rem">${[[S.entries.length,'entries recorded'],[r.length,'in the last 30 days'],[avg(r),'average severity (30 days)'],[fmtS(es[0].date),'most recent entry']].map(([n,l])=>`<div class="card stat"><b>${n}</b><span class="sm mu">${l}</span></div>`).join('')}</div><div class="g2"><div class="card"><div class="row sp"><h3>Timeline preview</h3>${goBtn('timeline','View all','sm')}</div><div class="tl">${es.slice(0,4).map(x=>entryCard(x)).join('')}</div></div><div class="card"><div class="row sp"><h3>Severity over time</h3>${goBtn('patterns','Explore','sm')}</div>${sevChart([...inRange(90)].sort((a,b)=>a.date.localeCompare(b.date)),ago(90),today())||'<p class="mu">No entries in the last 90 days.</p>'}${capt(inRange(90))}</div></div>`;

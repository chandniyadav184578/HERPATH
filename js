<div class="g2" style="margin-top:1rem"><div class="card"><h3>Care Passport</h3><p class="mu sm">${es.length?`Your summary currently covers ${ppEntries().length} entries. Review it, choose sections, and download.`:'Once you add entries, you can build a summary to share with a clinician.'}</p><div class="row">${goBtn('passport','Open Care Passport','p sm')}${goBtn('prep','Prepare appointment','sm')}</div></div><div class="card"><h3>Recent activity</h3>${act.length?act.map(a=>`<div class="sm" style="padding:.35rem 0;border-bottom:1px solid var(--line)"><b>${e(a[1])}</b><br><span class="mu">${e(a[2])}${a[0]?' · '+timeAgo(a[0]):''}</span></div>`).join(''):'<p class="mu sm">Activity will appear here.</p>'}</div></div>

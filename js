/* popover, modal, toast, tooltip */
let POP=null,CONF=null;
function closePop(){if(POP){POP.el.remove();POP.btn.setAttribute('aria-expanded','false');POP=null}}
function pop(btn,html){if(POP&&POP.btn===btn){closePop();return}closePop();const el=document.createElement('div');el.className='pop';el.style.position='fixed';el.setAttribute('role','dialog');el.setAttribute('aria-label',btn.getAttribute('aria-label')||'Menu');el.innerHTML=html;document.body.appendChild(el);const r=btn.getBoundingClientRect();el.style.top=(r.bottom+8)+'px';el.style.left=Math.max(8,r.right-el.offsetWidth)+'px';btn.setAttribute('aria-expanded','true');POP={el,btn};const f=$('a,button,input',el);f&&f.focus()}
function modal(html,label='Dialog'){const d=$('#dlg');d.setAttribute('aria-label',label);d.innerHTML='<div class="dlg">'+html+'</div>';if(!d.open)d.showModal()}
const closeModal=()=>{const d=$('#dlg');if(d.open)d.close()};
function confirmBox(title,msg,ok='Confirm',danger=true){return new Promise(res=>{CONF=res;modal(`<h3>${title}</h3><p>${msg}</p><div class="row" style="justify-content:flex-end;margin-top:1rem"><button class="btn" data-a="mno">Cancel</button><button class="btn ${danger?'d':'p'}" data-a="myes">${ok}</button></div>`,title)})}
function toast(msg,kind){const t=document.createElement('div');t.className='toast';t.setAttribute('role','status');t.innerHTML=ico(kind==='warn'?'alert':'check',18)+'<span>'+e(msg)+'</span>';$('#toasts').appendChild(t);setTimeout(()=>t.remove(),4200)}
document.addEventListener('mouseover',ev=>{const t=ev.target.closest('[data-tip]'),b=$('#tip');if(t){b.textContent=t.dataset.tip;b.hidden=false}else b.hidden=true});
document.addEventListener('mousemove',ev=>{const b=$('#tip');if(!b.hidden){b.style.left=Math.min(ev.clientX+14,innerWidth-b.offsetWidth-8)+'px';b.style.top=(ev.clientY+16)+'px'}});
document.addEventListener('focusin',ev=>{const t=ev.target.closest('[data-tip]'),b=$('#tip');if(t){const r=t.getBoundingClientRect();b.textContent=t.dataset.tip;b.hidden=false;b.style.left=Math.max(8,Math.min(r.left,innerWidth-b.offsetWidth-8))+'px';b.style.top=(r.bottom+8)+'px'}});
document.addEventListener('focusout',()=>{$('#tip').hidden=true});
/* charts */
function sevChart(es,from,to){if(!es.length)return'';const W=640,H=230,L=40,R=14,T=14,B=30;let a=from||es[0].date,b=to||es[es.length-1].date;const span=Math.max(dd(a,b),1),X=d=>L+(dd(a,d)/span)*(W-L-R),Y=s=>T+(5-s)/4*(H-T-B);let g='';
for(let s=1;s<=5;s++)g+=`<line class="gl" x1="${L}" x2="${W-R}" y1="${Y(s)}" y2="${Y(s)}"/><text x="${L-8}" y="${Y(s)+4}" text-anchor="end">${s}</text>`;
for(let i=0;i<=4;i++){const dt=new Date(a+'T00:00');dt.setDate(dt.getDate()+Math.round(span*i/4));g+=`<text x="${L+(W-L-R)*i/4}" y="${H-8}" text-anchor="${i==0?'start':i==4?'end':'middle'}">${fmtS(iso(dt))}</text>`}
const pts=es.map(x=>[X(x.date),Y(x.sev)]);
const line=pts.length>1?`<polyline fill="none" stroke="var(--soft2)" stroke-width="2.5" points="${pts.map(p=>p.join(',')).join(' ')}"/>`:'';
const dots=es.map((x,i)=>`<circle tabindex="0" cx="${pts[i][0]}" cy="${pts[i][1]}" r="6" fill="var(--s${x.sev})" stroke="var(--surface)" stroke-width="2" data-tip="${e(fmt(x.date)+' · '+(x.name||x.cat)+' · severity '+x.sev+'/5 ('+SEV[x.sev-1]+')')}" aria-label="${e(fmt(x.date)+', '+(x.name||x.cat)+', severity '+x.sev+' of 5')}"/>`).join('');
return `<svg class="chart" viewBox="0 0 ${W} ${H}" role="img" aria-label="Severity of recorded entries over time, scale 1 to 5">${g}${line}${dots}</svg>`}
function bars(rows,max){max=max||Math.max(1,...rows.map(r=>Math.max(r.v,r.v2||0)));return rows.map(r=>`<div class="bar"><span>${e(r.label)}</span><div class="t"><i style="width:${r.v/max*100}%" data-tip="${e(r.tip||r.label+': '+r.v)}"></i>${r.v2!=null?`<i class="b" style="width:${r.v2/max*100}%" data-tip="${e(r.tip2||'')}"></i>`:''}</div><b>${r.v}</b></div>`).join('')}
const sevChip=n=>`<span class="sev" data-s="${n}">${n}/5 · ${SEV[n-1]}</span>`;
const emptyState=(t,p,btn)=>`<div class="empty card">${emptyArt()}<h3>${t}</h3><p class="mu" style="max-width:30rem;margin:0 auto 1rem">${p}</p>${btn||''}</div>`;

async function paCheck(pw){const w=S.pa.pw;return !!w&&await paHash(pw,w.salt,w.it)===w.h}
const paLocked=()=>Date.now()<PA_FAIL.until;
async function paTry(pw){if(paLocked())return'locked';if(await paCheck(pw)){PA_FAIL.n=0;return'ok'}if(++PA_FAIL.n>=5){PA_FAIL.until=Date.now()+30e3;PA_FAIL.n=0;return'locked'}return'bad'}

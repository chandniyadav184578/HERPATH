function tlFiltered(){const f=V.tl;return sorted().filter(x=>(f.cat==='all'||x.cat===f.cat)&&x.sev>=f.min&&(!f.days||x.date>=ago(f.days))&&(!f.q||((x.name||'')+' '+x.cat+' '+(x.notes||'')).toLowerCase().includes(f.q.toLowerCase())))}

function prep(){const v=V.prep;if(v.sel===null)v.sel=inRange(30).map(x=>x.id);
const tabs=`<div class="tabs" role="tablist">${[['prep','Prepare'],['visit','After-visit notes']].map(([k,l])=>`<button class="tab" role="tab" data-a="preptab" data-v="${k}" aria-selected="${v.tab===k}">${l}</button>`).join('')}</div>`;const nx=[...S.visits].filter(x=>x.next&&x.next>=today()).sort((a,b)=>a.next.localeCompare(b.next))[0];const head=`<div class="hero-band"><div><span class="eyebrow">Consultation</span><h1>Appointment Preparation</h1><p class="mu" style="margin:0 0 .6rem">Select your entries, write your questions and bring a clear summary.</p>${nx?`<span class="chip sg">${ico("calendar",14)} Next visit noted: ${fmt(nx.next)} · in ${dd(today(),nx.next)} days</span>`:""}</div><div class="hb-art">${artAppt()}</div></div>${tabs}`;
if(v.tab==='visit'){const x=S.visits.find(i=>i.id===v.vid)||{date:today()};return`${head}<div class="g2" style="align-items:start"><form class="card" data-f="visit"><h3>${v.vid?'Edit update':'Add an after-visit update'}</h3><p class="sm mu">Your own notes. Not a verified medical record. No treatment advice is given here.</p><label for="vd">Visit date *</label><input id="vd" type="date" max="${today()}" value="${x.date}"><label for="vt">Topics discussed</label><textarea id="vt" rows="2" maxlength="800">${e(x.top)}</textarea><label for="vx">Tests / follow-up mentioned (as you recall)</label><textarea id="vx" rows="2" maxlength="800">${e(x.tests)}</textarea><label for="vn">Next appointment (optional)</label><input id="vn" type="date" value="${x.next||''}"><div class="err" id="verr" role="alert"></div><div class="row"><button class="btn p" type="submit">Save</button>${v.vid?'<button type="button" class="btn" data-a="vcancel">Cancel</button>':''}</div></form><div>${S.visits.length?[...S.visits].sort((a,b)=>b.date.localeCompare(a.date)).map(x=>`<div class="card" style="margin-bottom:.7rem"><div class="row sp"><b>${fmt(x.date)}</b><span class="chip">user-entered</span></div><p class="sm" style="margin:.4rem 0">${e(x.top)||'<span class="mu">No topics noted</span>'}</p><p class="sm mu">Next: ${fmt(x.next)}</p><div class="row"><button class="btn sm" data-a="vedit" data-id="${x.id}">Edit</button><button class="btn sm d" data-a="vdel" data-id="${x.id}">Delete</button></div></div>`).join(''):emptyState('No updates yet','After an appointment, note what was discussed so you remember it next time.')}</div></div>`}
const es=sorted();
return`${head}${!es.length?emptyState('Add entries first','Appointment preparation uses the entries on your timeline.',addFirst):`<div class="g2" style="align-items:start"><div class="stack"><div class="card"><div class="row sp"><h3>1 · Choose relevant entries</h3><span class="row"><button class="btn sm" data-a="prepall">Last 30 days</button><button class="btn sm" data-a="prepnone">Clear</button></span></div><div style="max-height:15rem;overflow:auto">${es.map(x=>`<label class="ck"><input type="checkbox" data-c="prepsel" data-v="${x.id}" ${v.sel.includes(x.id)?'checked':''}>${fmtS(x.date)} · ${e(x.name||x.cat)} · ${x.sev}/5</label>`).join('')}</div></div><div class="card"><h3>2 · Your concerns</h3><label for="ppc" class="sm" style="margin-top:0">What matters most to discuss?</label><textarea id="ppc" rows="3" maxlength="200" data-i="ppc">${e(S.pp.concern)}</textarea></div><div class="card"><h3>3 · Questions to ask</h3><div id="qed">${qEditor()}</div></div></div><div class="card" style="position:sticky;top:5rem"><h3>4 · Appointment summary</h3><pre id="prepsum" style="white-space:pre-wrap;font:inherit;font-size:.92rem;margin:0 0 1rem">${e(prepText())}</pre><div class="row"><button class="btn sm" data-a="prepcopy">${ico('copy',16)} Copy</button><button class="btn sm" data-a="prepdf">${ico('download',16)} PDF</button><button class="btn p sm" data-a="prepadd">${ico('file',16)} Add to Care Passport</button></div></div></div>`}`}
/* Library */
const libCard=a=>`<div class="card" role="button" tabindex="0" data-a="libopen" data-id="${a.id}" aria-label="Open article: ${e(a.t)}">${artLib(a.cat,"card-art")}<div class="row sp" style="margin-top:.7rem"><div class="fico" style="margin:0">${ico(a.ico,22)}</div>${S.bm.includes(a.id)?`<span class="chip">${ico('bookmark',14)} Saved</span>`:S.read.includes(a.id)?'<span class="chip sg">Read</span>':''}</div><h4 style="margin:.4rem 0 0">${e(a.t)}</h4><span class="sm mu">${a.cat} · ${a.min} min</span><span class="sm mu">${a.src?'Source: '+e(a.src.name):'General information'}</span></div>`;
function libList(){const f=V.lib,l=LIB.filter(a=>(f.cat==='all'||(f.cat==='saved'?S.bm.includes(a.id):a.cat===f.cat))&&(!f.q||(a.t+' '+a.cat+' '+a.body.join(' ')).toLowerCase().includes(f.q.toLowerCase())));return l.length?`<div class="lib">${l.map(libCard).join('')}</div>`:'<div class="card empty"><p>No articles match your search.</p></div>'}
function library(){const f=V.lib;return`<div class="hero-band"><div><span class="eyebrow">Learn</span><h1>Health Library</h1><p class="mu" style="margin:0">Plain-language notes on women’s health, each with a link to its source.</p></div><div class="hb-art">${artLib(LIBCATS[2])}</div></div><div class="ph"><div></div><div style="min-width:12rem"><span class="sm mu">${S.read.length} of ${LIB.length} read</span><div class="pbar"><i style="width:${S.read.length/LIB.length*100}%"></i></div></div></div><div class="banner">${ico('info',18)}<span>Plain-language summaries for general education. They do not replace advice from a qualified healthcare professional; use the source links for official guidance.</span></div><div class="row" style="margin-bottom:1rem"><div class="qs" style="max-width:20rem;margin:0"><span class="ic">${ico('search',18)}</span><input type="search" placeholder="Search articles" aria-label="Search articles" data-i="libq" value="${e(f.q)}"></div>${[['all','All'],...LIBCATS.map(c=>[c,c]),['saved','Saved']].map(([k,l])=>`<button class="chip" data-a="libcat" data-v="${e(k)}" aria-pressed="${f.cat===k}">${l}</button>`).join('')}</div><div id="liblist">${libList()}</div>`}
function libOpen(id){const a=LIB.find(x=>x.id===id);if(!a)return;if(!S.read.includes(id)){S.read.push(id);save()}const s=a.src;modal(`${artLib(a.cat,"modal-art")}<div class="row sp" style="margin-top:.8rem"><span class="chip">${a.cat}</span><button class="btn sm ic-only" data-a="mno" aria-label="Close">${ico('x',16)}</button></div><h3 style="margin-top:.6rem">${e(a.t)}</h3><p class="sm mu">${a.min} min read</p>${a.body.map(p=>`<p>${e(p)}</p>`).join('')}<div class="card" style="box-shadow:none;margin-top:1rem"><h4>Source</h4>${s?`<a href="${s.url}" target="_blank" rel="noopener noreferrer">${e(s.name)} ${ico('ext',14)}</a><p class="sm mu" style="margin:.3rem 0 0">${s.v?'Open the official page for full, authoritative guidance.':'Official organisation website. Search the topic there for full guidance.'}</p>`:'<p class="sm mu" style="margin:0">General wellbeing information.</p>'}<p class="sm mu" style="margin:.5rem 0 0">Educational information only, not medical advice. For personal concerns, speak with a qualified healthcare professional.</p></div><div class="row" style="margin-top:1rem"><button class="btn" data-a="libbm" data-id="${id}">${ico('bookmark',16)} ${S.bm.includes(id)?'Remove bookmark':'Bookmark'}</button></div>`,a.t);if($('#liblist'))$('#liblist').innerHTML=libList()}
/* Profile, notifications, settings */
function profile(){return`<div class="ph"><h1>Profile</h1></div><div class="g2" style="align-items:start"><div class="card"><div class="row"><span class="avatar" style="width:3.4rem;height:3.4rem;font-size:1.3rem">${initial()}</span><div><b>${e(S.profile.name||'Guest')}</b><br><span class="sm mu">${modeLabel()}</span></div></div><label for="pn">Display name (optional)</label><input id="pn" maxlength="40" value="${e(S.profile.name)}" data-i="pname"><p class="sm mu">Saved in this browser only. HERPATH does not need your medical history or other personal details.</p><label class="ck"><input type="checkbox" data-c="pps" data-k="name" ${S.pp.sel.name?'checked':''}> Include my display name in the Care Passport</label></div><div class="stack"><div class="card"><h3>Accessibility & language</h3><p class="mu sm">Theme, text size, motion and language are in settings.</p><a class="btn" href="#/app/settings">${ico('settings',16)} Open settings</a></div><div class="card"><h3>Access mode</h3><p class="sm mu">${S.set.mode==='private'?'Private mode: no account, saved on this device.':'Local profile: stored in this browser. There is no online account or server sign-in.'}</p><button class="btn" data-a="switch">Switch access mode</button></div><div class="card"><h3>Data shortcuts</h3><div class="row"><button class="btn sm" data-a="rvdata">${ico('eye',16)} Review</button><button class="btn sm" data-a="exdata">${ico('download',16)} Export</button><button class="btn sm d" data-a="cleardata">${ico('trash',16)} Clear</button></div></div></div></div>`}
function notifications(){return`<div class="ph"><div><h1>Notifications</h1><p class="mu" style="margin:0">Informational in-app messages. These are not healthcare alerts.</p></div><div class="row"><button class="btn sm" data-a="nread">Mark all read</button><button class="btn sm d" data-a="nclear">Clear all</button></div></div>${S.notifs.length?S.notifs.map(n=>`<div class="card" style="margin-bottom:.6rem;${n.read?'opacity:.75':''}"><div class="row sp" style="flex-wrap:nowrap"><div class="row" style="flex-wrap:nowrap;align-items:flex-start">${ico(n.kind==='success'?'check':n.kind==='reminder'?'clock':'info',20)}<div><b>${e(n.title)}</b> <span class="chip ${n.kind==='reminder'?'w':'sg'}">${n.kind}</span><br><span class="sm mu">${e(n.body)} · ${timeAgo(n.t)}</span></div></div><button class="btn sm" data-a="ndel" data-id="${n.id}" aria-label="Dismiss notification">${ico('x',16)}</button></div></div>`).join(''):emptyState('No notifications','Saving an entry or generating a Care Passport adds a message here. Reminders appear only if you turn them on in settings.')}`}
function settings(){const s=S.set;return`<div class="ph"><h1>Privacy & Settings</h1></div><div class="g2" style="align-items:start"><div class="stack"><div class="card"><h3>Appearance</h3><div class="sw"><span>Theme</span>${seg('theme',[['dark','Dark'],['light','Light']],s.theme)}</div><div class="sw"><span>Text size</span>${seg('text',[['s','Small'],['m','Medium'],['l','Large'],['xl','X-Large']],s.text)}</div><div class="sw"><span>Motion</span>${seg('motion',[['auto','Standard'],['reduce','Reduced']],s.motion)}</div><div class="sw"><span>Language</span>${seg('lang',[['en','English'],['hi','हिन्दी']],s.lang)}</div><p class="sm mu">Your theme and language choices are saved on this device.</p></div><div class="card"><h3>Notifications</h3><label class="ck"><input type="checkbox" data-c="setn" data-k="notifInfo" ${s.notifInfo?'checked':''}>Show informational messages (saved entry, Care Passport created)</label><label class="ck"><input type="checkbox" data-c="setn" data-k="remind" ${s.remind?'checked':''}>Remind me in the app to log, if I haven’t for</label><select aria-label="Reminder interval" data-c="setn" data-k="remindDays" style="max-width:10rem" ${s.remind?'':'disabled'}>${[3,7,14].map(d=>`<option value="${d}" ${s.remindDays==d?'selected':''}>${d} days</option>`).join('')}</select><p class="sm mu">Reminders only appear inside HERPATH when you open it. No push or email notifications are sent.</p></div></div><div class="stack"><div class="card"><h3>Your data</h3><p class="sm">Stored in this browser’s local storage on this device: <b>${S.entries.length}</b> entries, <b>${S.visits.length}</b> visit notes, <b>${S.notifs.length}</b> notifications. It is <b>not encrypted</b>, is not sent anywhere, may not appear on other devices, and can be lost if browser data is cleared.</p><div class="row"><button class="btn sm" data-a="rvdata">${ico('eye',16)} Review stored data</button><button class="btn sm" data-a="exdata">${ico('download',16)} Export (JSON)</button><button class="btn sm d" data-a="cleardata">${ico('trash',16)} Clear local data</button></div></div><div class="card"><h3>Privacy explained</h3><ul class="sm mu" style="padding-left:1.1rem;margin:0"><li>HERPATH has no online account or server.</li><li>You choose which sections go into your Care Passport and download it yourself.</li><li>Guidance is educational and not a diagnosis.</li><li>On a shared device, other people may be able to see local data.</li></ul></div></div></div>`}

@keyframes pin{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
/* landing */
.hero{position:relative;overflow:hidden;padding:3rem 0 4rem;background:radial-gradient(60rem 30rem at 85% -10%,var(--soft) 0,transparent 60%),radial-gradient(40rem 25rem at -10% 30%,var(--sage-soft) 0,transparent 60%)}.hero .wrap{display:grid;grid-template-columns:1.05fr .95fr;gap:2.5rem;align-items:center}.hero h1{color:var(--accent)}.hero .lead{font-size:1.15rem;color:var(--mute);max-width:36rem}.cta{display:flex;gap:.8rem;flex-wrap:wrap;margin:1.4rem 0}.eyebrow{display:inline-flex;gap:.4rem;align-items:center;font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:.75rem;color:var(--sage);margin-bottom:.8rem}
.art{width:100%;height:auto;display:block}.float{animation:flt 7s ease-in-out infinite}@keyframes flt{50%{transform:translateY(-8px)}}
section.sec{padding:4.5rem 0}.sec.alt{background:var(--surface2)}.sec-h{max-width:40rem;margin-bottom:2.2rem}.sec-h.c{margin-inline:auto;text-align:center}

input,select,textarea{font:inherit;color:var(--ink);background:var(--surface);border:1.5px solid var(--line);border-radius:12px;padding:.6rem .8rem;width:100%}textarea{resize:vertical}label{font-weight:600;font-size:.92rem;display:block;margin:.8rem 0 .3rem}label.ck{display:flex;gap:.6rem;align-items:center;font-weight:500;margin:.35rem 0;cursor:pointer}label.ck input{width:1.15rem;height:1.15rem;accent-color:var(--accent);flex:none}input[type=range]{padding:0;accent-color:var(--accent);border:0;background:none}

.main{min-width:0}.top{position:sticky;top:0;z-index:30;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line);display:flex;gap:.8rem;align-items:center;padding:.6rem 1.25rem}.top .greet{font:600 1.1rem var(--serif);white-space:nowrap}.qs{position:relative;flex:1;max-width:26rem;margin-left:auto}.qs input{padding-left:2.4rem;border-radius:999px}.qs .ic{position:absolute;left:.8rem;top:.75rem;color:var(--mute)}.qres{position:absolute;top:100%;left:0;right:0;margin-top:.3rem;background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:var(--sh);padding:.3rem;z-index:50}

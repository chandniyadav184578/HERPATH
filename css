/* Theme refinements, settings panel and Care Passport components (loaded after styles.css) */
html[data-theme=dark]{--bg:#120e16;--surface:#1b1621;--surface2:#261f2e;--line:#352c3e;--ink:#f3edf5;--mute:#bcb1c4;--sh:0 1px 0 rgba(255,255,255,.03) inset,0 14px 34px rgba(0,0,0,.38)}
html.tx,html.tx *{transition:background-color .35s ease,color .35s ease,border-color .35s ease,fill .35s ease,stroke .35s ease,box-shadow .35s ease!important}
.ibtn{transition:background-color .15s,transform .15s}.ibtn:hover{background:var(--soft)}.ibtn:active{transform:scale(.94)}
.btn{transition:transform .12s,background-color .15s,border-color .15s,box-shadow .15s}.btn:active{transform:translateY(1px)}
.mono{font-variant-numeric:tabular-nums;letter-spacing:.04em;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
.err{color:var(--danger);font-size:.88rem;min-height:1.2em;margin-top:.3rem}
/* settings panel */
.spn{margin:1.1rem 0}.spn h4{margin:0 0 .5rem;font-size:.95rem}
.themes{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}
.tcard{display:grid;gap:.55rem;justify-items:start;padding:.6rem;border:1.5px solid var(--line);border-radius:14px;background:var(--surface);color:var(--ink);font:inherit;cursor:pointer;transition:border-color .15s,box-shadow .15s}
.tcard:hover{border-color:var(--accent)}.tcard[aria-pressed=true]{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 25%,transparent)}
.tprev{display:grid;grid-template-columns:1fr 2fr;grid-template-rows:auto auto;gap:4px;width:100%;height:3.2rem;padding:6px;border-radius:9px}
.tprev i{border-radius:4px;display:block}.tprev i:first-child{grid-row:span 2}
.t-dark .tprev{background:#120e16}.t-dark .tprev i{background:#2d2436}.t-dark .tprev i:last-child{background:#cf94bd}
.t-light .tprev{background:#faf6ef}.t-light .tprev i{background:#e6dfd3}.t-light .tprev i:last-child{background:#5b2a4e}
/* care passport cover */
.pstage{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:1.4rem;align-items:start}
.pcover{position:relative;overflow:hidden;isolation:isolate;border-radius:26px;padding:1.5rem;color:#f6eef4;background:linear-gradient(155deg,#3d1e38 0%,#2a1530 58%,#1b1a3b 100%);border:1px solid rgba(255,255,255,.14);box-shadow:0 26px 60px -26px rgba(30,8,36,.7);display:grid;gap:1.3rem;grid-template-columns:1fr auto;grid-template-areas:"top top" "main qr" "act act"}
.pcover:before{content:"";position:absolute;inset:0;z-index:-1;background:repeating-radial-gradient(circle at 88% -10%,rgba(255,255,255,.06) 0 1px,transparent 1px 10px)}
.pcover:after{content:"";position:absolute;inset:-40%;z-index:-1;pointer-events:none;background:conic-gradient(from 200deg at 72% 28%,transparent,rgba(127,174,152,.2),rgba(217,164,65,.12),rgba(95,160,160,.2),transparent);opacity:.75;transition:transform 1.4s ease}
.pcover:hover:after{transform:rotate(22deg)}
.pc-top{grid-area:top;display:flex;align-items:center;gap:.8rem}.pc-top>div{display:grid;line-height:1.15}.pc-brand{letter-spacing:.16em;font-size:.95rem}.pc-sub{font-size:.8rem;opacity:.78}
.pc-chip{margin-left:auto;display:inline-flex;align-items:center;gap:.35rem;padding:.3rem .65rem;border-radius:999px;font-size:.78rem;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18)}
.ph .pc-chip{margin:0;background:var(--sage-soft);color:var(--sage);border-color:transparent}.pc-chip.ok{background:var(--sage-soft);color:var(--sage)}
.pc-main{grid-area:main;display:grid;gap:1.1rem;align-content:center}.pc-who{display:flex;align-items:center;gap:.9rem}
.pc-av{width:3.4rem;height:3.4rem;font-size:1.3rem;box-shadow:0 0 0 3px rgba(255,255,255,.18)}.pc-l{display:block;font-size:.78rem;opacity:.75}.pc-n{font:1.45rem/1.15 var(--serif)}
.pc-meta{display:grid;grid-template-columns:1fr 1fr;gap:.8rem 1.4rem;margin:0}.pc-meta dt{font-size:.74rem;opacity:.7}.pc-meta dd{margin:.1rem 0 0;font-size:.95rem}
.pc-qr{grid-area:qr;display:grid;gap:.4rem;justify-items:center;align-self:end}.pc-qr .sm{opacity:.8}
.qrtile{background:#fff;border-radius:16px;padding:.5rem;width:9.2rem;box-shadow:0 8px 24px rgba(0,0,0,.35)}.qrtile.big{width:min(15rem,80%);margin:1rem auto .4rem}.qr{display:block;width:100%;height:auto}
.pc-act{grid-area:act;display:flex;flex-wrap:wrap;gap:.7rem}.pcover .btn.p{background:#f4e3ef;color:#2a1530;border-color:transparent}.pc-sec{background:rgba(255,255,255,.1)!important;color:#f6eef4!important;border-color:rgba(255,255,255,.25)!important}
.srow{display:flex;gap:.7rem;align-items:flex-start;padding:.55rem 0;border-top:1px solid var(--line)}.srow:first-of-type{border-top:0}.srow .chip{margin-left:auto}
/* scanner */
.scan{position:relative;aspect-ratio:1;max-width:17rem;margin:.6rem auto;border-radius:20px;background:#0f0a13;overflow:hidden;display:grid;place-items:center;color:#9a8aa4}
.scan video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:none}.scan.live video{display:block}.scan.live .scanhint{display:none}
.scan span[class^=c]{position:absolute;width:2.2rem;height:2.2rem;border:3px solid var(--accent);border-radius:10px}.scan .c1{top:12%;left:12%;border-right:0;border-bottom:0}.scan .c2{top:12%;right:12%;border-left:0;border-bottom:0}.scan .c3{bottom:12%;left:12%;border-right:0;border-top:0}.scan .c4{bottom:12%;right:12%;border-left:0;border-top:0}
.scan .line{position:absolute;left:14%;right:14%;height:2px;background:linear-gradient(90deg,transparent,var(--accent),transparent);box-shadow:0 0 12px var(--accent);animation:sl 2.2s ease-in-out infinite}
@keyframes sl{0%,100%{top:16%}50%{top:82%}}
/* access gate */
.gate{padding:1.6rem;text-align:left}.gate h2{margin:.4rem 0}.gate.wide .paper{max-width:100%}.gate h4{margin:1rem 0 .3rem}
.gic{display:grid;place-items:center;width:3.4rem;height:3.4rem;border-radius:16px;background:var(--soft);color:var(--accent)}.gic.bad{background:var(--danger-soft);color:var(--danger)}.gic.warn{background:var(--warn);color:var(--warn-ink)}
@media(max-width:860px){.pstage{grid-template-columns:1fr}.pcover{grid-template-columns:1fr;grid-template-areas:"top" "main" "qr" "act"}.pc-qr{justify-items:start}}
@media(prefers-reduced-motion:reduce){.scan .line{animation:none;top:50%}.pcover:after{transition:none}html.tx,html.tx *{transition:none!important}}
html[data-motion=reduce] .scan .line{animation:none;top:50%}

.qs .ic .ic{position:static}

/* ---- visual upgrade: hero bands, illustrations, richer cards ---- */
.a-bg{fill:var(--soft)}.a-s2{fill:var(--soft2)}.a-sg{fill:var(--sage-soft)}.a-sg2{fill:var(--sage)}.a-sf{fill:var(--surface)}.a-ac{fill:var(--accent)}.a-ac2{fill:var(--teal)}.a-on{stroke:var(--on-accent);stroke-width:3;stroke-linecap:round;fill:none}.a-on2{fill:var(--on-accent)}
.a-ln,.a-ln2{stroke:var(--line);fill:none}.a-ln2{stroke:var(--soft2);stroke-width:4;stroke-linecap:round}.a-grid{stroke:var(--line);stroke-width:1;stroke-dasharray:3 5;fill:none}.a-line{stroke:var(--accent);stroke-width:3.5;stroke-linecap:round;stroke-linejoin:round;fill:none}.a-area{fill:var(--accent);opacity:.14}.a-ring{fill:none;stroke:var(--sage);stroke-width:8;stroke-dasharray:140 50;stroke-linecap:round}.a-tick{stroke:var(--on-accent);stroke-width:3;fill:none;stroke-linecap:round;stroke-linejoin:round}.a-skin{fill:#e8b99a}.a-skin2{fill:#c58d6b}.a-hair{fill:#3b2433}.a-hair2{fill:#2a1d2e}
.art{display:block;width:100%;height:auto;border-radius:14px}.card-art{border-radius:12px;margin:-.2rem 0 0;max-height:7rem}.modal-art{max-height:9rem}
.hero-band{display:grid;grid-template-columns:1.2fr 1fr;gap:1.5rem;align-items:center;margin-bottom:1.4rem;padding:1.4rem 1.6rem;border:1px solid var(--line);border-radius:22px;background:linear-gradient(135deg,var(--surface) 0%,var(--soft) 100%);box-shadow:var(--sh);position:relative;overflow:hidden}.hero-band:before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:linear-gradient(var(--accent),var(--teal))}.hero-band h1{font-size:clamp(1.8rem,3.2vw,2.5rem);margin-bottom:.3rem}.hb-art{max-width:25rem;justify-self:end;width:100%}
.eyebrow{display:inline-block;font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:var(--teal);margin-bottom:.3rem}
.card{transition:transform .18s,box-shadow .18s,border-color .18s}.lib .card:hover,.stat:hover{transform:translateY(-3px);border-color:var(--accent)}
.stat{position:relative;overflow:hidden}.stat:after{content:"";position:absolute;left:0;right:0;bottom:0;height:3px;background:linear-gradient(90deg,var(--accent),var(--teal),var(--sage))}.stat b{font-family:var(--serif);font-size:2rem}
.welcome{background:linear-gradient(135deg,var(--surface),var(--soft))}
@media(max-width:760px){.hero-band{grid-template-columns:1fr;padding:1.1rem}.hb-art{justify-self:stretch;max-width:none}}
:root{--bg:#faf6ef;--surface:#fffdf9;--surface2:#f3ede2;--ink:#2b2730;--mute:#665f6c;--line:#e6dfd3;--accent:#5b2a4e;--accent2:#431c3a;--on-accent:#fff;--soft:#ece6f5;--soft2:#d9cdea;--sage:#4f7261;--sage-soft:#dfeae3;--teal:#2f7a78;--warn:#fff4dc;--warn-ink:#6b4a00;--danger:#8f1f3d;--danger-soft:#fbe9ee;--s1:#7fae98;--s2:#5fa0a0;--s3:#d9a441;--s4:#b9547a;--s5:#7a2a5e;--sh:0 1px 2px rgba(60,30,60,.06),0 10px 28px rgba(60,30,60,.08);--serif:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;--sans:system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans","Noto Sans Devanagari",sans-serif}
html[data-theme=dark]{--bg:#16121a;--surface:#1f1a24;--surface2:#2a2330;--ink:#f1ebf3;--mute:#b9aec0;--line:#3a3140;--accent:#cf94bd;--accent2:#e0b0d1;--on-accent:#1b1020;--soft:#2f2438;--soft2:#45355a;--sage:#8fb5a2;--sage-soft:#223028;--teal:#6cc0bd;--warn:#35290f;--warn-ink:#f1d18a;--danger:#ff9db5;--danger-soft:#3a1824;--sh:0 1px 2px rgba(0,0,0,.4),0 10px 28px rgba(0,0,0,.35)}

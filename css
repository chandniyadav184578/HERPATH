#view{padding:1.5rem 1.25rem 5rem;max-width:1100px;margin:0 auto;animation:pin .3s}.ph{display:flex;gap:1rem;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;margin-bottom:1.3rem}.ph h1{font-size:clamp(1.7rem,3vw,2.3rem);margin:0}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.row{display:flex;gap:.6rem;align-items:center;flex-wrap:wrap}.sp{justify-content:space-between}.stack>*+*{margin-top:1rem}
.welcome{display:grid;grid-template-columns:1.2fr .8fr;gap:1rem;align-items:center;background:linear-gradient(120deg,var(--soft),var(--sage-soft));border:0}.stat b{font:600 2rem var(--serif);display:block;color:var(--accent)}
.banner{background:var(--warn);color:var(--warn-ink);border-radius:14px;padding:.8rem 1rem;display:flex;gap:.7rem;align-items:center;flex-wrap:wrap;margin-bottom:1rem;font-size:.92rem}.urgent{background:var(--danger-soft);color:var(--ink);border:1.5px solid var(--danger);border-radius:16px;padding:1rem 1.2rem}.urgent h4{color:var(--danger);margin:0 0 .4rem}
.empty{text-align:center;padding:2rem 1rem}.empty svg{max-width:220px;margin:0 auto 1rem}
.tl{position:relative;padding-left:2.2rem}.tl:before{content:"";position:absolute;left:.7rem;top:.4rem;bottom:.4rem;width:2px;background:var(--soft2)}.tli{position:relative;margin-bottom:.8rem}.tli .dot{position:absolute;left:-1.95rem;top:1rem;width:1.1rem;height:1.1rem;border-radius:50%;border:3px solid var(--surface);box-shadow:0 0 0 2px var(--soft2)}.tli.hl .card{outline:2px solid var(--teal)}.tli h4{margin:0}.mh{font:700 .8rem var(--sans);text-transform:uppercase;letter-spacing:.08em;color:var(--mute);margin:1.2rem 0 .6rem;padding-left:.2rem}
.sev{display:inline-flex;align-items:center;gap:.35rem;font-size:.8rem;font-weight:700;padding:.15rem .6rem;border-radius:999px;color:#fff}.sev[data-s="1"]{background:var(--s1);color:#10241b}.sev[data-s="2"]{background:var(--s2);color:#071f1f}.sev[data-s="3"]{background:var(--s3);color:#2d2000}.sev[data-s="4"]{background:var(--s4)}.sev[data-s="5"]{background:var(--s5)}
.cats{display:grid;grid-template-columns:repeat(4,1fr);gap:.8rem}.catc{display:flex;flex-direction:column;align-items:center;gap:.5rem;padding:1.1rem .5rem;border-radius:18px;border:2px solid var(--line);background:var(--surface);cursor:pointer;font:600 .92rem var(--sans);color:var(--ink);transition:all .15s;text-align:center}.catc:hover{transform:translateY(-2px);border-color:var(--soft2)}.catc[aria-pressed=true]{border-color:var(--accent);background:var(--soft)}
.prog{display:flex;gap:.4rem;margin-bottom:1.2rem}.prog i{flex:1;height:.4rem;border-radius:9px;background:var(--soft2)}.prog i.on{background:var(--accent)}.svl{font:600 1.6rem var(--serif);text-align:center;margin:.4rem 0}.ticks{display:flex;justify-content:space-between;font-size:.75rem;color:var(--mute)}
.bar{display:grid;grid-template-columns:9rem 1fr 2.2rem;gap:.7rem;align-items:center;margin:.45rem 0;font-size:.9rem}.bar .t{height:1.1rem;background:var(--soft);border-radius:9px;overflow:hidden}.bar .t i{display:block;height:100%;background:var(--accent);border-radius:9px;transition:width .5s}.bar .t i.b{background:var(--sage);margin-top:2px;height:60%}
.chart{width:100%;height:auto}.chart text{fill:var(--mute);font:11px var(--sans)}.chart .gl{stroke:var(--line)}.chart circle{cursor:pointer}.chart circle:focus{outline:none;stroke:var(--teal);stroke-width:3}
#tip{position:fixed;z-index:99;background:var(--ink);color:var(--bg);padding:.4rem .7rem;border-radius:8px;font-size:.82rem;pointer-events:none;max-width:16rem}
.tabs{display:flex;gap:.3rem;border-bottom:1px solid var(--line);margin-bottom:1rem;overflow:auto}.tab{padding:.6rem 1rem;border:0;background:none;font:600 .95rem var(--sans);color:var(--mute);cursor:pointer;border-bottom:3px solid transparent}.tab[aria-selected=true]{color:var(--accent);border-color:var(--accent)}
.lib{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.lib .card{display:flex;flex-direction:column;gap:.5rem;cursor:pointer;transition:transform .15s}.lib .card:hover{transform:translateY(-3px)}.pbar{height:.5rem;border-radius:9px;background:var(--soft);overflow:hidden}.pbar i{display:block;height:100%;background:var(--sage)}
dialog{border:0;border-radius:22px;padding:0;max-width:min(40rem,calc(100vw - 1.5rem));width:100%;background:var(--surface);color:var(--ink);box-shadow:0 30px 80px rgba(30,5,30,.35)}dialog::backdrop{background:rgba(25,10,30,.5)}dialog[open]{animation:pin .2s}.dlg{padding:1.5rem;max-height:85vh;overflow:auto}
#toasts{position:fixed;bottom:5rem;left:50%;transform:translateX(-50%);z-index:100;display:grid;gap:.5rem;width:min(26rem,calc(100vw - 1.5rem))}.toast{background:var(--ink);color:var(--bg);padding:.8rem 1rem;border-radius:14px;box-shadow:var(--sh);display:flex;gap:.6rem;align-items:center;animation:pin .2s}
.sw{display:flex;gap:.5rem;align-items:center;justify-content:space-between;padding:.7rem 0;border-bottom:1px solid var(--line)}.seg{display:inline-flex;border:1.5px solid var(--line);border-radius:999px;overflow:hidden}.seg button{border:0;background:none;padding:.45rem .9rem;font:600 .88rem var(--sans);color:var(--ink);cursor:pointer}.seg button[aria-pressed=true]{background:var(--accent);color:var(--on-accent)}
.bnav{display:none}.ov{display:none}
.access{min-height:100vh;display:grid;place-items:center;padding:2rem 1rem;background:radial-gradient(50rem 30rem at 80% 0,var(--soft),transparent 60%),var(--bg)}.access .opts{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:1.5rem}.access .opt{display:flex;flex-direction:column;gap:.6rem;text-align:left}
@media(max-width:980px){.hero .wrap,.split{grid-template-columns:1fr}.split.rev>:first-child{order:0}.bento{grid-template-columns:repeat(2,1fr)}.b2,.b3,.b4{grid-column:span 2}.steps{grid-template-columns:1fr 1fr}.steps:before{display:none}.safe,.lib,.g3,.access .opts{grid-template-columns:1fr 1fr}.ft .cols{grid-template-columns:1fr 1fr}.nav .l{display:none}.nav.open .l{display:block}.burger{display:grid}}
@media(max-width:900px){.app{grid-template-columns:1fr}.side{position:fixed;left:0;top:0;width:17rem;transform:translateX(-105%);transition:transform .25s;box-shadow:var(--sh)}.side.open{transform:none}.ov.on{display:block;position:fixed;inset:0;background:rgba(20,10,25,.45);z-index:35}.bnav{display:flex;position:fixed;bottom:0;left:0;right:0;z-index:30;background:var(--surface);border-top:1px solid var(--line);padding:.3rem .3rem calc(.3rem + env(safe-area-inset-bottom))}.bnav a,.bnav button{flex:1;display:flex;flex-direction:column;align-items:center;gap:.1rem;padding:.35rem 0;font:600 .68rem var(--sans);color:var(--mute);text-decoration:none;background:none;border:0;cursor:pointer}.bnav [aria-current=page]{color:var(--accent)}.top .greet{display:none}.welcome,.g2{grid-template-columns:1fr}.g4{grid-template-columns:1fr 1fr}#toasts{bottom:5.5rem}}
@media(max-width:640px){.hero{padding-top:1.5rem}.nav{position:static}.nav.open{position:absolute;top:4.2rem;left:0;right:0;flex-direction:column;background:var(--surface);padding:.8rem;border-bottom:1px solid var(--line);align-items:stretch}.cats{grid-template-columns:1fr 1fr}.bento,.safe,.lib,.g3,.g4,.steps,.access .opts,.ft .cols{grid-template-columns:1fr}.b2,.b3,.b4{grid-column:auto}.bar{grid-template-columns:6.5rem 1fr 2rem}.hd .btn.p.hide-sm{display:none}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}.rv{opacity:1;transform:none}}
html[data-motion=reduce] *{animation:none!important;transition:none!important;scroll-behavior:auto!important}
@media print{body *{visibility:hidden}.paper,.paper *{visibility:visible}.paper{position:absolute;left:0;top:0;width:100%;box-shadow:none;border:0}}
.sbtn{display:none}.top .chipmode{white-space:nowrap}
@media(max-width:900px){.sbtn{display:grid}.top .chipmode span{display:none}}

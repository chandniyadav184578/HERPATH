.card{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:1.25rem;box-shadow:var(--sh)}.chip{display:inline-flex;align-items:center;gap:.35rem;padding:.25rem .7rem;border-radius:999px;background:var(--soft);color:var(--accent);font-size:.8rem;font-weight:600;border:1px solid transparent}.chip.sg{background:var(--sage-soft);color:var(--sage)}.chip.w{background:var(--warn);color:var(--warn-ink)}
